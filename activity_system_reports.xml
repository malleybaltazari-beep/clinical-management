<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">


    <!-- ================================================= -->
    <!-- TOP BAR                                           -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:background="#009688">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="System Reports"
            android:textColor="@android:color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- REPORT CONTENT                                    -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- PAGE TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Reports"
                android:textColor="#17202A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Overview of the Clinical Patient Management System"
                android:textColor="#777777"
                android:textSize="13sp" />


            <!-- ================================================= -->
            <!-- GENERAL STATISTICS                                -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="General Statistics"
                android:textColor="#009688"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtPatients"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Patients: 0"
                android:textColor="#17202A"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/txtDoctors"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Doctors: 0"
                android:textColor="#17202A"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/txtUsers"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Users: 0"
                android:textColor="#17202A"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/txtAppointments"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Appointments: 0"
                android:textColor="#17202A"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/txtMedicalRecords"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Medical Records: 0"
                android:textColor="#17202A"
                android:textSize="16sp" />


            <!-- ================================================= -->
            <!-- APPOINTMENT STATUS                                -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Appointment Status"
                android:textColor="#009688"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtPending"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Pending: 0"
                android:textColor="#17202A"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/txtCompleted"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Completed: 0"
                android:textColor="#17202A"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/txtCancelled"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Cancelled: 0"
                android:textColor="#17202A"
                android:textSize="16sp" />


            <!-- ================================================= -->
            <!-- TODAY'S REPORT                                    -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Today's Activity"
                android:textColor="#009688"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtToday"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Today's Appointments: 0"
                android:textColor="#009688"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- BOTTOM SPACE -->

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>