<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ========================= -->
        <!-- TOP BAR                   -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="#009688">

            <!-- Back Button -->

            <ImageButton
                android:id="@+id/btnDoctorBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Doctor Dashboard"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- WELCOME SECTION           -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtDoctorWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome, Doctor"
                android:textColor="#17202A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage your patients and appointments"
                android:textColor="#777777"
                android:textSize="13sp"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- QUICK ACTIONS             -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textColor="#17202A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginTop="5dp" />


        <!-- ========================= -->
        <!-- VIEW MY PATIENTS           -->
        <!-- ========================= -->

        <Button
            android:id="@+id/btnDoctorPatients"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="View My Patients"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:backgroundTint="#009688"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="12dp" />


        <!-- ========================= -->
        <!-- APPOINTMENTS              -->
        <!-- ========================= -->

        <Button
            android:id="@+id/btnDoctorAppointments"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Today's Appointments"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:backgroundTint="#009688"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="10dp" />


        <!-- ========================= -->
        <!-- MEDICAL RECORDS           -->
        <!-- ========================= -->

        <Button
            android:id="@+id/btnMedicalRecords"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Medical Records"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:backgroundTint="#009688"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="10dp" />


        <!-- ========================= -->
        <!-- PRESCRIPTIONS             -->
        <!-- ========================= -->

        <Button
            android:id="@+id/btnPrescriptions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Prescriptions"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#009688" />


    </LinearLayout>

</ScrollView>