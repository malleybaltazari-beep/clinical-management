<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ========================= -->
        <!-- TOP BAR                   -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="#009688">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Make Appointment"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- FORM                     -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book an Appointment"
                android:textColor="#17202A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Enter the details of your appointment"
                android:textColor="#777777"
                android:textSize="13sp" />


            <!-- ========================= -->
            <!-- PATIENT ID               -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtPatientId"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:hint="Patient ID"
                android:inputType="number"
                android:padding="15dp"
                android:backgroundTint="#009688" />


            <!-- ========================= -->
            <!-- DOCTOR NAME              -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtDoctorName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Doctor Name"
                android:inputType="textPersonName"
                android:padding="15dp"
                android:backgroundTint="#009688" />


            <!-- ========================= -->
            <!-- APPOINTMENT DATE          -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtAppointmentDate"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Appointment Date"
                android:inputType="date"
                android:padding="15dp"
                android:backgroundTint="#009688" />


            <!-- ========================= -->
            <!-- APPOINTMENT TIME          -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtAppointmentTime"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Appointment Time"
                android:inputType="time"
                android:padding="15dp"
                android:backgroundTint="#009688" />


            <!-- ========================= -->
            <!-- REASON                   -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/edtReason"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:hint="Reason for Appointment"
                android:inputType="textMultiLine"
                android:padding="15dp"
                android:backgroundTint="#009688" />


            <!-- ========================= -->
            <!-- SAVE BUTTON              -->
            <!-- ========================= -->

            <Button
                android:id="@+id/btnSaveAppointment"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Book Appointment"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#009688" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>